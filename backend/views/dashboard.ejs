<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    body {
      background-color: #070b12;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      padding: 32px;
      margin: 0;
    }
    .header {
      border-bottom: 1px solid #1e293b;
      padding-bottom: 16px;
      margin-bottom: 24px;
    }
    .title {
      color: #00e5ff;
      margin: 0 0 8px 0;
      font-size: 26px;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .card {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 16px;
    }
    .label {
      color: #64748b;
      font-size: 12px;
      text-transform: uppercase;
    }
    .val {
      color: #00ff88;
      font-size: 20px;
      font-weight: bold;
      margin-top: 4px;
    }
    .user-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .user-item {
      padding: 8px 12px;
      background: #1e293b;
      border-radius: 4px;
      margin-bottom: 6px;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 class="title"><%= title %></h1>
    <p style="color: #94a3b8; margin: 0;">Server-Side Rendered via Express EJS Template Engine</p>
  </div>

  <div class="grid">
    <div class="card">
      <div class="label">Server Status</div>
      <div class="val"><%= status %></div>
    </div>
    <div class="card">
      <div class="label">Uptime</div>
      <div class="val" style="color: #00e5ff;"><%= uptime %>s</div>
    </div>
    <div class="card">
      <div class="label">Active Users</div>
      <div class="val" style="color: #f59e0b;"><%= users.length %></div>
    </div>
  </div>

  <div class="card">
    <h3 style="color: #00e5ff; margin-top: 0;">Registered Operator Sessions (Pre-Rendered on Server)</h3>
    <ul class="user-list">
      <% users.forEach(function(u) { %>
        <li class="user-item">
          <span><strong><%= u.username %></strong> (<%= u.email %>)</span>
          <span style="color: #00ff88;"><%= u.role.toUpperCase() %></span>
        </li>
      <% }); %>
    </ul>
  </div>
</body>
</html>
