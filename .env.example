# ==========================================
# JARVIS ECOSYSTEM - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. LLM Brain & Ollama Server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60.0
OLLAMA_TEMPERATURE=0.2

# 2. Database & Persistence
DATABASE_URL=sqlite:///data/jarvis_relational.db
CHROMA_COLLECTION_NAME=jarvis_episodic_memory
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# 3. Cache & Redis Tier
REDIS_URL=redis://localhost:6379/0

# 4. Authentication & Security
JARVIS_JWT_SECRET=jarvis-super-secure-production-secret-key-2026
JARVIS_JWT_EXPIRY_MINS=120

# 5. REST & WebSocket Microservices
HOST=127.0.0.1
PORT=8000
